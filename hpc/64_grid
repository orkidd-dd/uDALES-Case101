echo "Starting 64-grid preprocessing: $(date)"
echo "Host: $(hostname)"

cd "$DA_TOOLSDIR"
matlab -batch "expnr=101; write_inputs" > "{root}/preprocessing.log" 2>&1

python3 "{root}/validate_64grid.py"

test -x /home/jili/u-dales/build/release/u-dales
mkdir "{out}"
cp -r "{case}/." "{out}/"

export OMP_NUM_THREADS=1
cd "{out}"

echo "Starting 64-grid uDALES: $(date)"
mpirun --bind-to none --map-by slot -np 4 \
    /home/jili/u-dales/build/release/u-dales namoptions.101

echo "uDALES finished: $(date)"
'''

(root / "run_64grid.slurm").write_text(job)

print(f"New input directory: {case}")
print(f"New output directory: {out}")
print(f"Preprocessing log: {root}/preprocessing.log")
print("Existing cases and results were retained.")
PY

printf '\n===== Check submission script =====\n'
bash -n "$COARSE_ROOT/run_64grid.slurm"

printf '\n===== Submit preprocessing and simulation =====\n'
sbatch "$COARSE_ROOT/run_64grid.slurm"

printf '\n===== Current queue =====\n'
squeue -u "$(id -un)"

printf '\n===== Save this working directory =====\n'
printf '%s\n' "$COARSE_ROOT"
BASH

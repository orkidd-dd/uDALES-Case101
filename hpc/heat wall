% Load building geometry
TR = stlread('H:\udales_data\u-dales-output\101_128\geom.101.STL');

% Calculate triangle centres
F = TR.ConnectivityList;
P = TR.Points;

centers = (P(F(:,1),:) + P(F(:,2),:) + P(F(:,3),:)) / 3;

% Find faces on the wall at x = 24 m
idx = abs(centers(:,1) - 24) < 1e-6;
wall_faces = find(idx);

disp('Wall face numbers at x = 24 m:')
disp(wall_faces)

% Highlight selected faces
figure('Color','w')
trisurf(TR,'FaceColor',[0.8 0.8 0.8], ...
    'EdgeColor','none','FaceAlpha',0.3)
hold on

patch('Faces',F(wall_faces,:), ...
    'Vertices',P, ...
    'FaceColor','r', ...
    'EdgeColor','k')

xlabel('x (m)')
ylabel('y (m)')
zlabel('z (m)')
axis equal

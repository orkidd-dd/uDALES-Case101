python3 - <<'PY'
import struct
from pathlib import Path

data = Path("geom.101.STL").read_bytes()
n = struct.unpack_from("<I", data, 80)[0]
assert len(data) == 84 + 50*n, "Unexpected STL format"

target_x = 80 / 3
faces = []

for i in range(n):
    v = struct.unpack_from("<12fH", data, 84 + 50*i)
    points = (v[3:6], v[6:9], v[9:12])
    if all(abs(p[0] - target_x) < 1e-4 for p in points):
        faces.append(i + 1)

print("Upwind wall x:", target_x)
print("Face count:", len(faces))
print("Face IDs:", faces)
print("Temperature file lines:", [i + 1 for i in faces])

import os
import re
from pathlib import Path

root = Path(os.environ["SCRATCH_FLASH"])
template = root / "u-dales-run/101_HW15/run_101.slurm"
text = template.read_text()

for delta in (70, 170, 240):
    case = root / f"u-dales-run/101_HW15_downwind_{delta}K"
    output = root / f"output/HW15_downwind_{delta}K"
    script = case / "run_101.slurm"

    if script.exists():
        raise SystemExit(f"Script already exists: {script}")
    if output.exists():
        raise SystemExit(f"Output directory already exists: {output}")

for delta in (70, 170, 240):
    case = root / f"u-dales-run/101_HW15_downwind_{delta}K"
    output = root / f"output/HW15_downwind_{delta}K"
    updated = text

    replacements = [
        (r"^INPUTDIR=.*$", f'INPUTDIR="{case / "101"}"'),
        (r"^OUTDIR=.*$", f'OUTDIR="{output}"'),
        (r"^#SBATCH --job-name=.*$",
         f"#SBATCH --job-name=HW15_DW{delta}"),
    ]

    for pattern, replacement in replacements:
        updated, count = re.subn(
            pattern, lambda m: replacement, updated, flags=re.MULTILINE
        )
        assert count == 1, f"Expected one matching line: {pattern}"

    updated = updated.replace(
        "# ---- Software environment ----",
        "set -euo pipefail\n\n# ---- Software environment ----"
    )
    (case / "run_101.slurm").write_text(updated)
    print(f"Created: {case / 'run_101.slurm'}")
    print(f"Output: {output}")

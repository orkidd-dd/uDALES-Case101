%% Grid resolution sensitivity: TKE

tke64 = sim64.load_stat_xyt('tketxyc');
tke128 = sim128.load_stat_xyt('tketxyc');

H = 16;

figure
plot(mean(tke64, 2), sim64.zt/H, 'b-', 'LineWidth', 1.5);

%% mean velocity vercity profiles u
clc
clear all
% load data
file0k   = 'H:\udales_data\u-dales-output\101_128';
file70k  = 'H:\udales_data\u-dales-output\101_70k';
file170k = 'H:\udales_data\u-dales-output\101_170k';
file240k = 'H:\udales_data\u-dales-output\101_240k';

sim0k   = udbase(101,file0k);
sim70k  = udbase(101,file70k);
sim170k = udbase(101,file170k);
sim240k = udbase(101,file240k);

z=sim0k.zt(:);
x=sim0k.xm(:)
y=sim0k.yt(:)
 
% Load velocity data
ut0   = sim0k.load_stat_t('ut');
ut70  = sim70k.load_stat_t('ut');
ut170 = sim170k.load_stat_t('ut');
ut240 = sim240k.load_stat_t('ut');
% Time averaging: 600–3500 s
time = ncread(fullfile(file0k,'tdump.101.nc'),'time');

% Select time interval
idx = time > 600 & time <= 3500;


% Time averaging
u0_mean   = mean(ut0(:,:,:,idx),4,'omitnan');
u70_mean  = mean(ut70(:,:,:,idx),4,'omitnan');
u170_mean = mean(ut170(:,:,:,idx),4,'omitnan');
u240_mean = mean(ut240(:,:,:,idx),4,'omitnan');

u_ref=0.14
H=16

% Target canyon centre
xc = 32;
yc = 32;
% find nearest grid points for each case
[~,ix] = min(abs(sim0k.xm(:)-xc));
[~,iy] = min(abs(sim0k.yt(:)-yc));
% Extract vertical profiles
u0_centre   = squeeze(u0_mean(ix,iy,:));
u70_centre  = squeeze(u70_mean(ix,iy,:));
u170_centre = squeeze(u170_mean(ix,iy,:));
u240_centre = squeeze(u240_mean(ix,iy,:));

% Add no-slip boundary condition at ground level
z_plot = [0; z];

u0_plot   = [0; u0_centre];
u70_plot  = [0; u70_centre];
u170_plot = [0; u170_centre];
u240_plot = [0; u240_centre];
% Compare mean streamwise velocity profiles
figure

plot(u0_plot/u_ref, z_plot/H, ...
    'DisplayName','0 K','LineWidth',1.5)
hold on

plot(u70_plot/u_ref, z_plot/H, ...
    'DisplayName','70 K','LineWidth',1.5)

plot(u170_plot/u_ref, z_plot/H, ...
    'DisplayName','170 K','LineWidth',1.5)

plot(u240_plot/u_ref, z_plot/H, ...
    'DisplayName','240 K','LineWidth',1.5)

xlabel('$\overline{u}/u_*$','Interpreter','latex')
ylabel('$z/H$','Interpreter','latex')
title('Mean Streamwise Velocity Profiles at Canyon Centre')

yline(1,'--k','Building height', ...
    'LineWidth',1.2, ...
    'HandleVisibility','off');

legend('show','Location','northwest')
grid on



%% mean velocity horizontal profiles V
% ---------------- 2. Horizontal Profile (Red Line) ----------------
% Load data
wt0   = sim0k.load_stat_t('wt');
wt70  = sim70k.load_stat_t('wt');
wt170 = sim170k.load_stat_t('wt');
wt240 = sim240k.load_stat_t('wt');

% Coordinates w(xt.yt,zm)
xm = sim0k.xt(:);
zm = sim0k.zm(:);

H = 16;
u_ref = 0.14;

% Average along y-direction and time
w_xz0   = squeeze(mean(mean(wt0,2,'omitnan'),4,'omitnan'));
w_xz70  = squeeze(mean(mean(wt70,2,'omitnan'),4,'omitnan'));
w_xz170 = squeeze(mean(mean(wt170,2,'omitnan'),4,'omitnan'));
w_xz240 = squeeze(mean(mean(wt240,2,'omitnan'),4,'omitnan'));


% Extract canyon domain (x between 24m and 40m)
L = (xm >= 24 & xm <= 40);
x = xm(L);


% Extract horizontal profiles at z = 8.25 m
z_mid = 8.25;
[~,iz] = min(abs(zm-z_mid));

w0   = w_xz0(L,iz);
w70  = w_xz70(L,iz);
w170 = w_xz170(L,iz);
w240 = w_xz240(L,iz);

% Normalize velocity
w_norm0   = w0(:)/u_ref;
w_norm70  = w70(:)/u_ref;
w_norm170 = w170(:)/u_ref;
w_norm240 = w240(:)/u_ref;

% Normalize x coordinate
x_norm = (x(:)-32)/H;

% Apply zero velocity at canyon sidewalls
x_norm = [-0.5; x_norm; 0.5];
% Pad profiles with zero velocity at canyon sidewalls
w_norm0   = [0; w_norm0; 0];
w_norm70  = [0; w_norm70; 0];
w_norm170 = [0; w_norm170; 0];
w_norm240 = [0; w_norm240; 0];
% Plot
figure('Color','w')

plot(x_norm,w_norm0,'LineWidth',1.5,'DisplayName','0 K')
hold on
plot(x_norm,w_norm70,'LineWidth',1.5,'DisplayName','70 K')
plot(x_norm,w_norm170,'LineWidth',1.5,'DisplayName','170 K')
plot(x_norm,w_norm240,'LineWidth',1.5,'DisplayName','240 K')

xlabel('x/H')
ylabel('w/u_*')
title('Vertical velocity horizontal profiles at z/H = 0.5')

legend('Location','best')
grid on

%%
%%
clc
clear
close all

% Case folders
folders = {
    'H:\udales_data\u-dales-output\101_128'
    'H:\udales_data\u-dales-output\101_70k'
    'H:\udales_data\u-dales-output\101_170k'
    'H:\udales_data\u-dales-output\101_240k'
};

labels = {'0 K', '70 K', '170 K', '240 K'};
styles = {':', '-', '--', '-.'};

% Geometry and sampling locations
H = 16;
xc = 32;
yc = 32;

x_left = 24;
x_right = 40;
z_mid = 0.5*H;

% Reference friction velocity
u_ref = 0.14;

% Select statistical outputs
time_start = 600;
time_end = 3500;

% Store profiles
U_profiles = cell(4,1);
Z_profiles = cell(4,1);
W_profiles = cell(4,1);
X_profiles = cell(4,1);

for n = 1:4

    % Load case
    sim = udbase(101, folders{n});

    % Load coordinates for each staggered grid
    xm = sim.load_stat_t('xm');
    xt = sim.load_stat_t('xt');
    yt = sim.load_stat_t('yt');
    zt = sim.load_stat_t('zt');
    zm = sim.load_stat_t('zm');

    xm = double(xm(:));
    xt = double(xt(:));
    yt = double(yt(:));
    zt = double(zt(:));
    zm = double(zm(:));

    time = sim.load_stat_t('time');
    time = time(:);

    selected = time > time_start & time <= time_end;

    assert(any(selected), ...
        'No statistical outputs in the selected range for %s.', labels{n});

    % Load velocity statistics
    % U coordinates: xm, yt, zt
    % W coordinates: xt, yt, zm
    ut = sim.load_stat_t('ut');
    wt = sim.load_stat_t('wt');

    assert(size(ut,1) == numel(xm) && ...
           size(ut,2) == numel(yt) && ...
           size(ut,3) == numel(zt) && ...
           size(ut,4) == numel(time), ...
        'Unexpected U dimensions for %s.', labels{n});

    assert(size(wt,1) == numel(xt) && ...
           size(wt,2) == numel(yt) && ...
           size(wt,3) == numel(zm) && ...
           size(wt,4) == numel(time), ...
        'Unexpected W dimensions for %s.', labels{n});

    % Average selected statistical intervals
    % Equal interval durations are assumed
    u_mean = double(mean(ut(:,:,:,selected), 4));
    w_mean = double(mean(wt(:,:,:,selected), 4));

    clear ut wt

    % Check target coordinates
    assert(xc >= min(xm) && xc <= max(xm), ...
        'The target x coordinate is outside the U grid.');

    assert(yc >= min(yt) && yc <= max(yt), ...
        'The target y coordinate is outside the grid.');

    assert(z_mid >= min(zm) && z_mid <= max(zm), ...
        'The target height is outside the W grid.');

    % Build interpolants on the correct staggered grids
    % No extrapolation is allowed
    Fu = griddedInterpolant({xm, yt, zt}, u_mean, ...
        'linear', 'none');

    Fw = griddedInterpolant({xt, yt, zm}, w_mean, ...
        'linear', 'none');
% Vertical U profile at the canyon centre
z = zt(zt > 0 & zt <= H);

u = Fu( ...
    xc*ones(size(z)), ...
    yc*ones(size(z)), ...
    z);

% Add the no-slip boundary point at the ground: U = 0 at z = 0
z = [0; z(:)];
u = [0; u(:)];

Z_profiles{n} = z/H;
U_profiles{n} = u/u_ref;

    % Horizontal W profile at the exact target plane and height
    x = xt(xt > x_left & xt < x_right);

    w = Fw( ...
        x, ...
        yc*ones(size(x)), ...
        z_mid*ones(size(x)));

   % Add W = 0 at the two building walls
x_plot = [x_left; x(:); x_right];
w_plot = [0; w(:); 0];

X_profiles{n} = (x_plot-xc)/H;
W_profiles{n} = w_plot/u_ref;

  

    % Report signed velocity at the largest magnitude
    valid = find(isfinite(w));

    if ~isempty(valid)
        [~, j] = max(abs(w(valid)));
        imax = valid(j);

        fprintf('Largest |W| at x = %.4f m\n', x(imax));
        fprintf('Signed W = %.4f m/s\n', w(imax));
        fprintf('Signed W/u_ref = %.4f\n', w(imax)/u_ref);
    end

    % Inspect the last six points near the right wall
    wall_data = table(x(:), w(:), w(:)/u_ref, ...
        'VariableNames', {'x_m', 'W_m_s', 'W_over_ustar'});

    fprintf('Points near the right wall:\n');
    disp(wall_data(max(1,height(wall_data)-5):end,:));

    clear Fu Fw u_mean w_mean
end

% Combined figure
figure('Color', 'w', 'Position', [100 100 900 750]);

% Black axes: vertical U profiles
ax1 = axes('Position', [0.13 0.13 0.74 0.72]);
hold(ax1, 'on');

p = gobjects(4,1);

for n = 1:4
    p(n) = plot(ax1, U_profiles{n}, Z_profiles{n}, ...
        'Color', 'k', ...
        'LineStyle', styles{n}, ...
        'LineWidth', 1.8);
end

ax1.XAxisLocation = 'bottom';
ax1.YAxisLocation = 'right';
ax1.XColor = 'k';
ax1.YColor = 'k';
ax1.FontSize = 12;
ax1.Box = 'off';

xlabel(ax1, 'U/u_*');
ylabel(ax1, 'z/H');
ylim(ax1, [0 1]);

legend(ax1, p, labels, 'Location', 'northwest');

% Red axes: horizontal W profiles
ax2 = axes('Position', ax1.Position, ...
    'XAxisLocation', 'top', ...
    'YAxisLocation', 'left', ...
    'Color', 'none');

hold(ax2, 'on');

for n = 1:4
    plot(ax2, X_profiles{n}, W_profiles{n}, ...
        'Color', 'r', ...
        'LineStyle', styles{n}, ...
        'LineWidth', 1.8, ...
        'HandleVisibility', 'off');
end

ax2.XColor = 'r';
ax2.YColor = 'r';
ax2.FontSize = 12;
ax2.Box = 'off';

xlabel(ax2, '(x-x_c)/H');
ylabel(ax2, 'W/u_*');

xlim(ax2, [(x_left-xc)/H, (x_right-xc)/H]);

% Automatic velocity limits keep all peaks visible
title(ax2, 'Mean Velocity Profiles in the Street Canyon');

ax2.Position = ax1.Position;
%% if want seperate change from % Combined figure
%% Figure 1: Vertical U profiles at the canyon centre
figure('Color', 'w', 'Position', [100 100 650 650]);
hold on

for n = 1:4
    plot(U_profiles{n}, Z_profiles{n}, ...
        'Color', 'k', ...
        'LineStyle', styles{n}, ...
        'LineWidth', 1.8);
end

xlabel('U/u_*');
ylabel('z/H');

ylim([0 1]);

legend(labels, 'Location', 'best');
title('Vertical Mean U Profiles at the Canyon Centre');

set(gca, 'FontSize', 12);
box on


%% Figure 2: Horizontal W profiles at z/H = 0.5
figure('Color', 'w', 'Position', [800 100 650 650]);
hold on

for n = 1:4
    plot(X_profiles{n}, W_profiles{n}, ...
        'Color', 'r', ...
        'LineStyle', styles{n}, ...
        'LineWidth', 1.8);
end

xlabel('(x-x_c)/H');
ylabel('W/u_*');

xlim([(x_left-xc)/H, (x_right-xc)/H]);

legend(labels, 'Location', 'best');
title('Horizontal Mean W Profiles at z/H = 0.5');

set(gca, 'FontSize', 12);
box on
